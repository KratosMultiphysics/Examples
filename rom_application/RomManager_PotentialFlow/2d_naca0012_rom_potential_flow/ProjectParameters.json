                       "gauss_point_results" : ["WAKE","KUTTA","MACH","DENSITY","VELOCITY","DECOUPLED_TRAILING_EDGE_ELEMENT","ACTIVATION_LEVEL"]
                   },
                   "point_data_configuration"  : []
               }
           }
       }]
       ,
       "vtk_output" : [{
           "python_module" : "vtk_output_process",
