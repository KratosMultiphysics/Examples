{
    "analysis_stage"   : "KratosMultiphysics.CompressiblePotentialFlowApplication.potential_flow_analysis",
    "problem_data"                     : {
        "problem_name"    : "naca4_digit",
        "parallel_type"   : "OpenMP",
        "echo_level"      : 0,
        "start_time"      : 0.0,
        "end_time"        : 1.0
    },
"modelers" : [{
        "name"       : "Modelers.KratosMultiphysics.ImportMDPAModeler",
        "parameters" : {
            "input_filename"  : "baseline_coarse",
            "model_part_name"  : "FluidModelPart"
        }
    }],
    "solver_settings" : {
        "solver_type"            : "ale_potential_flow",
        "ale_boundary_parts"     : ["Body"],
        "mesh_motion_solver_settings" :{
            "solver_type" : "structural_similarity",
            "reform_dofs_each_step" : false,
            "echo_level": 0
        },

        "fluid_solver_settings"  :{
            "solver_type"     :"potential_flow",
            "domain_size"     : 2,
            "model_part_name" : "FluidModelPart",
            "formulation": {
                        "element_type":"compressible"
            },
            "model_import_settings"  : {
                "input_type" : "use_input_model_part"
            },
            "maximum_iterations"     : 50,
            "echo_level"             : 0,
            "potential_application_echo_level" : 0,
            "linear_solver_settings" : {
                    "solver_type"    : "LinearSolversApplication.amgcl"
            },
            "volume_model_part_name" : "FluidModelPart.Fluid",
            "skin_parts"             : ["FluidModelPart.FarField","FluidModelPart.Body"],
            "no_skin_parts"          : [],
            "auxiliary_variables_list": ["DISTANCE", "REACTION"]
        }
    },
    "processes" : {
        "initial_conditions_process_list"  : [],
        "boundary_conditions_process_list" : [{
            "python_module" : "apply_far_field_and_wake_process",
            "kratos_module" : "KratosMultiphysics.CompressiblePotentialFlowApplication",
            "process_name"  : "ApplyFarFieldAndWakeProcess",
            "Parameters"    : {
                "model_part_name" : "FluidModelPart.FarField",
                "angle_of_attack_units": "degrees",
                "free_stream_density"   : 1.225,
                "angle_of_attack"       : 1.0,
                "mach_infinity"         : 0.2,
                "initialize_flow_field": true,
                "define_wake": true,
                "wake_type": "Operations.KratosMultiphysics.CompressiblePotentialFlowApplication.Define2DWakeOperation",
                "wake_parameters"    : {
                    "body_model_part_name" : "FluidModelPart.Body"
                }
            }
        },{
            "python_module": "compute_lift_process",
            "kratos_module": "KratosMultiphysics.CompressiblePotentialFlowApplication",
            "process_name": "ComputeLiftProcess",
            "Parameters": {
                "model_part_name": "FluidModelPart.Body",
                "moment_reference_point": [0.25, 0.0, 0.0],
                "mean_aerodynamic_chord": 1.0,
                "trailing_edge_model_part_name": "FluidModelPart.TrailingEdgeNode",
                "far_field_model_part_name": "FluidModelPart.FarField",
                "is_infinite_wing": false
            }
        },{
            "python_module" : "fix_vector_variable_process",
            "kratos_module" : "KratosMultiphysics",
            "help"          : "This process fixes the selected components of a given vector variable",
            "Parameters"    : {
                "model_part_name" : "FluidModelPart.FarField",
                "variable_name"   : "MESH_DISPLACEMENT",
                "constrained"      : [true,true,true]
            }
        },{
            "python_module" : "fix_vector_variable_process",
            "kratos_module" : "KratosMultiphysics",
            "help"          : "This process fixes the selected components of a given vector variable",
            "Parameters"    : {
                "model_part_name" : "FluidModelPart.Body",
                "variable_name"   : "MESH_DISPLACEMENT",
                "constrained"      : [true,true,true]
            }
        },{
            "python_module" : "compute_nodal_value_process",
            "kratos_module" : "KratosMultiphysics.CompressiblePotentialFlowApplication",
            "Parameters"    : {
                "model_part_name" : "FluidModelPart",
                "elemental_variables_list_to_project" : ["PRESSURE_COEFFICIENT"]
            }
        }]
    },
    "output_processes" : {
       "gid_output" : [{
           "python_module" : "gid_output_process",
           "kratos_module" : "KratosMultiphysics",
           "process_name"  : "GiDOutputProcess",
           "help"          : "This process writes postprocessing files for GiD",
           "Parameters"    : {
               "model_part_name"        : "FluidModelPart",
               "output_name"            : "gid_output/output",
               "postprocess_parameters" : {
                   "result_file_configuration" : {
                       "gidpost_flags"       : {
                           "GiDPostMode"           : "GiD_PostBinary",
                           "WriteDeformedMeshFlag": "WriteDeformed",
                           "WriteConditionsFlag"   : "WriteConditions",
                           "MultiFileFlag"         : "MultipleFiles"
                       },
                       "file_label"          : "step",
                       "output_control_type" : "step",
                       "output_interval"     : 1,
                       "body_output"         : true,
                       "node_output"         : false,
                       "skin_output"         : false,
                       "plane_output"        : [],
                       "nodal_nonhistorical_results": [],
                       "nodal_results"       : ["VELOCITY_POTENTIAL", "AUXILIARY_VELOCITY_POTENTIAL","MESH_DISPLACEMENT"],
                       "gauss_point_results" : ["MACH","DENSITY","VELOCITY","PRESSURE_COEFFICIENT"]
                   },
                   "point_data_configuration"  : []
               }
           }
       }]
       ,
       "vtk_output" : [{
           "python_module" : "vtk_output_process",
           "kratos_module" : "KratosMultiphysics",
           "process_name"  : "VtkOutputProcess",
           "help"          : "This process writes postprocessing files for Paraview",
           "Parameters"    : {
               "model_part_name"                    : "FluidModelPart",
               "output_control_type"                : "step",
               "output_interval"                    : 1,
               "file_format"                        : "binary",
               "output_precision"                   : 7,
               "output_sub_model_parts"             : false,
               "output_path"                        : "vtk_output/output",
               "save_output_files_in_folder"        : true,
               "write_deformed_configuration"       : true,
               "nodal_solution_step_data_variables" : ["VELOCITY_POTENTIAL","AUXILIARY_VELOCITY_POTENTIAL","MESH_DISPLACEMENT"],
               "nodal_data_value_variables"         : ["PRESSURE_COEFFICIENT"],
               "element_data_value_variables"       : [],
               "gauss_point_variables_in_elements"  : ["VELOCITY","DENSITY","MACH","PRESSURE_COEFFICIENT"],
               "condition_data_value_variables"     : []
           }
       }]
   }
}